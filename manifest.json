{
  "manifest_version": 3,
  "name": "Daily Timekeeper",
  "version": "1.0.0",
  "description": "Timekeeper for scrum dailies: per-person timeboxes, meeting timebox, speaking queue, parking lot and summary.",
  "permissions": ["storage", "alarms", "notifications", "sidePanel"],
  "action": {
    "default_title": "Daily Timekeeper",
    "default_popup": "timer.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "timer.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116"
}
